{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/research",
      "destination": "/labs",
      "permanent": true
    },
    {
      "source": "/use-cases",
      "destination": "/case-studies",
      "permanent": true
    },
    {
      "source": "/hana-sleep/analysis",
      "destination": "/sleep/analysis",
      "permanent": true
    },
    {
      "source": "/hana-sleep/cpap",
      "destination": "/sleep/cpap",
      "permanent": true
    },
    {
      "source": "/hana-sleep",
      "destination": "/sleep",
      "permanent": true
    },
    {
      "source": "/access",
      "destination": "/programs/access-model",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/api/not-found"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
